# Synthetic, privacy-safe manual-QA sample audio (see manual-qa/samples/README.md)
!/manual-qa/samples/audio/normal_lesson.wav
# M12 Round 3 QA-spec fix (m01-02): same audio content as normal_lesson.wav
# under a distinct filename, so the SRT/VTT-equivalence test no longer
# collides with the product's intentional duplicate-file-path invariant.
!/manual-qa/samples/audio/normal_lesson2.wav

# Manual QA temporary and generated artifacts. Deliberately narrow: only the
# two specifically-named, audited fixtures above are ever un-ignored — never
# a blanket `manual-qa/samples/**` allow, which would silently make any real
# recording or export a tester drops into samples/ committable (see M14
# pre-merge privacy corrective).
manual-qa/*.json
manual-qa/**/*.json
manual-qa/*.srt
manual-qa/*.vtt
# Same narrow-allow-list treatment as the audio fixtures above: any new
# .srt/.vtt dropped under samples/subtitles/ is ignored by default; only the
# six specifically audited fixtures are un-ignored (see samples/README.md).
manual-qa/samples/subtitles/*.srt
manual-qa/samples/subtitles/*.vtt
!/manual-qa/samples/subtitles/normal_lesson.srt
!/manual-qa/samples/subtitles/normal_lesson.vtt
!/manual-qa/samples/subtitles/boundary_stress.srt
!/manual-qa/samples/subtitles/invalid_non_numeric_index.srt
!/manual-qa/samples/subtitles/invalid_timing_backwards.srt
!/manual-qa/samples/subtitles/invalid_missing_webvtt_header.vtt
manual-qa/*.db
manual-qa/screenshots/
manual-qa/results/**
!manual-qa/results/.gitkeep

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
~$*

# Design-scratch working folder (screenshots/prototypes/decision notes) —
# local-only per M14 pre-merge repository hygiene corrective. Not a
# replacement scratch location; the Product Owner's local files stay put,
# they simply stop being tracked/pushed.
/UI design/
